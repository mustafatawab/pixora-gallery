# Copy to .env.local and fill from `bun run supabase status -o env` for local dev,
# or from the Supabase dashboard (Project Settings -> API) for hosted projects.
# See docs/environments.md.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: ANON_KEY. Cloud: publishable key (sb_publishable_...) or legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this with a NEXT_PUBLIC_ prefix.
# Local: SERVICE_ROLE_KEY. Cloud: secret key (sb_secret_...) or legacy service_role JWT.
# Only needed for admin tasks (cleanup jobs, seeding). Not used by app reads/writes.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Protects /api/cron/cleanup-orphans.
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional. Set to "true" to send Strict-Transport-Security from a non-Vercel
# HTTPS host. Vercel sets VERCEL=1 automatically. Leave unset for local HTTP.
ENABLE_HSTS=
